# Copy to .env and fill in. Blank keys are filled in as their phase arrives.

# Access Key from unsplash.com/developers, Demo tier.
UNSPLASH_ACCESS_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Matches the docker-compose service.
DATABASE_URL=postgresql://wicken:wicken@127.0.0.1:5432/wicken

# Created and migrated by `pnpm test`; truncated between tests.
TEST_DATABASE_URL=postgresql://wicken:wicken@127.0.0.1:5432/wicken_test

# Local only; Railway gets its own.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth client ID, Web application type, from console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-mode key (sk_test_) from dashboard.stripe.com.
STRIPE_SECRET_KEY=

# Printed by `stripe listen`; the production endpoint has a different one.
STRIPE_WEBHOOK_SECRET=
